---
import Base from './Base.astro';
interface Props {title:string;description:string;label?:string;schema?:Record<string,unknown>|Record<string,unknown>[];noindex?:boolean;}
const {title,description,label,schema,noindex} = Astro.props;
---
<Base title={`${title} | ZEC Buying Price`} description={description} schema={schema} noindex={noindex}>
  <div class="wrap document-shell"><a class="back-link" href="/">← ZEC Buying Price</a><header class="document-header">{label && <p class="eyebrow">{label}</p>}<h1>{title}</h1><p class="document-lead">{description}</p></header><div class="prose"><slot /></div></div>
</Base>
